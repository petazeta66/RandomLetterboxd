# Token Bearer de TMDB (https://www.themoviedb.org/settings/api)
TMDB_API_TOKEN=your_tmdb_bearer_token_here

# URL del frontend desplegado (para restringir CORS en producción).
# Ejemplo: https://letterboxd-randomizer.vercel.app
# En local puedes dejarlo vacío o usar *
FRONTEND_URL=https://tu-app.vercel.app
